<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GameResource.Package.XxHash64Compatibility</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../GameResource.Package/GameResource.Package.csproj" />
    <!-- Oracle only for this validation executable, never a production/test dependency. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
