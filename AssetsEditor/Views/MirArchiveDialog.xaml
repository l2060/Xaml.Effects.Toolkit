<Window x:Class="Assets.Editor.Views.MirArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xkit="http://schemas.l2030.com/xkit"
        Title="{Binding Title}" Width="640" MinWidth="640" SizeToContent="Height"
        Background="{DynamicResource GLOBAL_BACKGROUND_COLOR}"
        Icon="/Assets.Editor;component/Assets/Icon.png"
        Style="{DynamicResource xKit-WindowChrome VisualStudio}"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <xkit:WindowTheme.Theme>
        <xkit:WindowTheme BorderBrush="{DynamicResource GLOBAL_WINDOW_BORDER_COLOR}"
                          ExitCommand="{Binding ExitCommand}" MaxButton="Collapsed" MinButton="Collapsed" />
    </xkit:WindowTheme.Theme>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel IsEnabled="{Binding CanEdit}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Label Content="资源包：" Padding="0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" VerticalContentAlignment="Center" ToolTip="{Binding SourcePath}" />
                <Button Grid.Column="2" Content="…" Width="36" Height="28" HorizontalAlignment="Right" Command="{Binding SelectSourceCommand}" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Label Content="{Binding OutputLabel}" Padding="0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" VerticalContentAlignment="Center" ToolTip="{Binding OutputPath}" />
                <Button Grid.Column="2" Content="…" Width="36" Height="28" HorizontalAlignment="Right" Command="{Binding SelectOutputCommand}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Label Content="调色板：" Padding="0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding PalettePath, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" VerticalContentAlignment="Center" ToolTip="留空使用资源自带或默认调色板；仅影响索引色图片。" />
                <Button Grid.Column="2" Content="…" Width="36" Height="28" HorizontalAlignment="Right" Command="{Binding SelectPaletteCommand}" />
            </Grid>
            <TextBlock Text="WIL 需同目录下的 WIX，WZL 需同目录下的 WZX；调色板可留空。"
                       TextWrapping="Wrap" Margin="84,0,0,12" Foreground="{DynamicResource GLOBAL_FOREGROUND_COLOR}" />
            <StackPanel Visibility="{Binding IsAssetMode, Converter={StaticResource BoolVisibility}}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Label Content="资源密码：" Padding="0" VerticalAlignment="Center" />
                    <PasswordBox Grid.Column="1" MinHeight="28" VerticalContentAlignment="Center" xkit:PasswordBoxHelper.Attach="True"
                                 xkit:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay}" />
                </Grid>
                <CheckBox Content="压缩 asset 图片数据" IsChecked="{Binding Compress}" Margin="84,0,0,12" />
            </StackPanel>
            <CheckBox Content="将黑底特效转换为透明效果" IsChecked="{Binding GenerateAlpha}" Margin="84,0,0,12"
                      ToolTip="仅对没有原生 Alpha 的图片生效；默认保留资源原有透明规则。" />
            <TextBlock Text="{Binding OutputHint}" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource GLOBAL_FOREGROUND_COLOR}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="96" ToolTip="{Binding StatusText}" Foreground="{DynamicResource GLOBAL_FOREGROUND_COLOR}" />
            <DockPanel Margin="0,8,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:F0}%}" Foreground="{DynamicResource GLOBAL_FOREGROUND_COLOR}" />
                <TextBlock Text="{Binding CountsText}" Foreground="{DynamicResource GLOBAL_FOREGROUND_COLOR}" />
            </DockPanel>
        </StackPanel>
        <ProgressBar Grid.Row="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,16" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding ActionText}" Command="{Binding SubmitCommand}" Background="{DynamicResource GLOBAL_PRIMARY_COLOR}" Width="112" Height="32" />
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Width="112" Height="32" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
